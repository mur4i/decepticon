# GitHub repo secrets needed:
#   XAI_API_KEY            xAI / Grok token (https://console.x.ai)
#   GITHUB_TOKEN           injected automatically by Actions
#
# Optional repo variable:
#   GROK_MODEL             default "grok-3". Free tier may prefer "grok-3-mini".
#
# Local dev needs nothing. Set this only if the repo is not <user>.github.io;
# the deploy workflow sets it automatically in CI.
NEXT_PUBLIC_BASE_PATH=
