# GitHub Models is the brain. The workflow's GITHUB_TOKEN is the only auth.
# No external API key required for inference.

# Optional repo variable:
#   LLM_MODEL              default "openai/gpt-4o-mini".

# Set this only if the repo is not <user>.github.io; the deploy workflow
# sets it automatically in CI.
NEXT_PUBLIC_BASE_PATH=

# URL of the Cloudflare TTS Worker that proxies Microsoft Edge neural voices.
# Deploy worker/ once, set this as a GitHub repo variable (NOT a secret),
# and chronicle pages start narrating with Aria/Francisca/etc. Leave empty
# and the pages fall back to the browser's native Web Speech API.
NEXT_PUBLIC_TTS_WORKER_URL=
