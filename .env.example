# GitHub Models is the brain. The workflow's GITHUB_TOKEN is the only auth.
# No external API key required.
#
# Optional repo variable:
#   LLM_MODEL              default "openai/gpt-4o-mini".
#                          Other options: openai/gpt-4o, meta/llama-3.3-70b-instruct,
#                          microsoft/phi-4, deepseek/deepseek-v3, etc.
#
# Local dev needs nothing. Set this only if the repo is not <user>.github.io;
# the deploy workflow sets it automatically in CI.
NEXT_PUBLIC_BASE_PATH=
